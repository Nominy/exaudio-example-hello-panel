{
  "id": "example.hello-panel",
  "name": "Hello panel",
  "version": "0.2.0",
  "api": "^0.2.0",
  "runtime": "wasm",
  "description": "Example extension: inserts a greeting.",
  "license": "MIT",
  "dependencies": {},
  "permissions": [{ "kind": "document-read" }, { "kind": "document-edit" }, { "kind": "secrets" }],
  "providers": [{ "id": "example.hello.account", "name": "Hello account" }],
  "modes": [
    {
      "id": "example.hello.notes",
      "name": "Hello notes",
      "provider": "example.hello.account",
      "launch": "direct"
    }
  ],
  "contributes": {
    "actions": [
      {
        "id": "example.hello-panel.greet",
        "title": { "en": "Insert greeting", "ru": "Вставить приветствие" },
        "when": "editorOpen",
        "menus": [{ "menu": "editor/overflow", "group": "example" }],
        "keys": [{ "key": "ctrl-alt-g" }]
      }
    ]
  }
}
